/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cra-assistant-agent",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-11",
	"assets": {
		// Required by Wrangler CLI. Vite (`npm run dev` / `vite build`) ignores
		// this path and writes the real client output into dist/client.
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/agents/*"],
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"ai": {
		"binding": "AI",
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
			"allowed_sender_addresses": ["cra-assistant@warwarsn.online"],
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CraAssistantAgent",
				"name": "CraAssistantAgent",
			},
			{
				"name": "RegulatoryRAGAgent",
				"class_name": "RegulatoryRAGAgent",
			},
		],
	},
	"migrations": [
		{
			"tag": "1",
			"new_sqlite_classes": ["CraAssistantAgent"],
		},
		{
			"tag": "2",
			"new_sqlite_classes": ["RegulatoryRAGAgent"],
		},
	],
	"r2_buckets": [
		{
			"bucket_name": "cra-assistant-skills",
			"binding": "SKILLS",
			"remote": true,
		},
		{
			"bucket_name": "cra-assistant-bucket",
			"binding": "FILES",
			"remote": true,
		},
	],
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"workflows": [
		{
			"name": "regulatory-briefing-workflow",
			"binding": "REGULATORY_BRIEFING_WORKFLOW",
			"class_name": "RegulatoryBriefingWorkflow",
		},
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "cra-regulatory-rag",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "HISTORY_DB",
			"database_name": "cra-assistant-agent-d1",
			"database_id": "2dbbb509-d59a-4c78-b11a-bba6dc1100b4",
			"remote": true,
		},
	],
	"vars": {
		"RENDER_SERVICE_URL": "https://cra-rbm-assistant.onrender.com",
	},
	"secrets": {
		"required": ["KONECT_FALLBACK_TOKEN"],
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
